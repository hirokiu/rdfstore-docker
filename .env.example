VIRTUOSO_ADMIN_PASSWORD=change-this-password
VIRTUOSO_IMAGE=openlink/virtuoso-opensource-7:7.2.17-r24-g49d82bd-ubuntu
VIRTUOSO_HTTP_PORT=8890

VIRTUOSO_DATABASE_DIR=./virtuoso
RDF_DATA_DIR=./data
RDF_DEFAULT_GRAPH=https://example.org/graph

# Tune these values to the RAM available on the host.
VIRT_PARAMETERS_NUMBEROFBUFFERS=170000
VIRT_PARAMETERS_MAXDIRTYBUFFERS=130000
